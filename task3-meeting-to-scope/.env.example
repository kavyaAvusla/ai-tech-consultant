# Copy this file to .env and fill the two secrets by hand. Never commit .env.
# KB_API_KEY is the Knowledge Brain X-API-Key (same value as APP_API_KEY in the repo-root .env).
# ANTHROPIC_API_KEY is the Anthropic key already used by Task 1. Do not paste either key into chat or logs.
KB_API_URL=http://127.0.0.1:8000
KB_API_KEY=
ANTHROPIC_API_KEY=
MODEL_NAME=claude-haiku-5-5
# Leave blank. The tools show hours until a reviewer sets a number here. Do not invent a rate.
HOURLY_RATE=
